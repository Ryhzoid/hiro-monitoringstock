-- ---------- Cara menambah pengguna (dilakukan manual) ----------
-- Tidak ada fitur tambah pengguna di website. Untuk setiap orang baru:
--  1. Supabase > Authentication > Users > Add user: isi email dan password,
--     centang "Auto Confirm User".
--  2. Jalankan di SQL Editor (ganti nama, email, dan role). Id diambil
--     otomatis dari email, jadi tidak perlu menyalin UUID:
--
--   insert into profiles (id, nama, email, role)
--   select id, 'Nama Lengkap', email, 'manajer'   -- atau 'admin'
--   from auth.users
--   where email = 'email@perusahaan.com';
--
-- Buat akun MANAJER pertama lebih dulu. Lupa password: reset lewat
-- Authentication > Users. Matikan juga opsi pendaftaran bebas (sign up)
-- di pengaturan Authentication.